<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="practice_world">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <include>
      <uri>model://start_marker</uri>
      <name>start_pad</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://waypoint_marker</uri>
      <name>wp1_marker</name>
      <pose>3.0 0.0 2.5 0 0 0</pose>
    </include>
    <include>
      <uri>model://waypoint_marker</uri>
      <name>wp2_marker</name>
      <pose>5.0 2.0 2.5 0 0 0</pose>
    </include>
    <include>
      <uri>model://waypoint_marker</uri>
      <name>wp3_marker</name>
      <pose>8.0 5.0 2.5 0 0 0</pose>
    </include>
    <include>
      <uri>model://waypoint_marker</uri>
      <name>wp4_marker</name>
      <pose>12.0 8.0 2.5 0 0 0</pose>
    </include>

    <model name="obstacle_cylinder_1">
      <static>true</static>
      <pose>6.5 3.0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.4</radius><length>4.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>4.0</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.35 0.2 1</ambient>
            <diffuse>0.6 0.4 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_box_1">
      <static>true</static>
      <pose>9.5 4.0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 4.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 4.0</size></box></geometry>
          <material>
            <ambient>0.45 0.45 0.5 1</ambient>
            <diffuse>0.55 0.55 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cluster_A">
      <static>true</static>
      <pose>4.0 0.5 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>4.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>4.0</length></cylinder></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient></material>
        </visual>
      </link>
    </model>
    
    <model name="obstacle_cluster_B">
      <static>true</static>
      <pose>4.0 1.8 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>4.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>4.0</length></cylinder></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_wall">
      <static>true</static>
      <pose>7.0 6.5 2.0 0 0 0.5</pose> <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 0.2 4.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 0.2 4.0</size></box></geometry>
          <material><ambient>0.2 0.8 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="trap_left">
      <static>true</static>
      <pose>10.5 7.5 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.2 4.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.2 4.0</size></box></geometry><material><ambient>0.8 0.8 0.1 1</ambient></material></visual>
      </link>
    </model>
    <model name="trap_center">
      <static>true</static>
      <pose>11.5 6.5 2.0 0 0 1.57</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.2 4.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.2 4.0</size></box></geometry><material><ambient>0.8 0.8 0.1 1</ambient></material></visual>
      </link>
    </model>
    <model name="trap_right">
      <static>true</static>
      <pose>10.5 5.5 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.2 4.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.2 4.0</size></box></geometry><material><ambient>0.8 0.8 0.1 1</ambient></material></visual>
      </link>
    </model>

    <include>
      <uri>model://landing_pad</uri>
      <name>landing_pad</name>
      <pose>15.0 9.0 0 0 0 0</pose>
    </include>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-5 -5 15 0 0.6 0.7</pose>
      </camera>
    </gui>

  </world>
</sdf>
