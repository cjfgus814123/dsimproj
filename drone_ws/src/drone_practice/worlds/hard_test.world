<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="practice_world">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <include>
      <uri>model://start_marker</uri>
      <name>start_pad</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include><uri>model://waypoint_marker</uri><name>wp1_marker</name><pose>5.0 0.0 2.5 0 0 0</pose></include>
    <include><uri>model://waypoint_marker</uri><name>wp2_marker</name><pose>10.0 4.0 2.5 0 0 0</pose></include>
    <include><uri>model://waypoint_marker</uri><name>wp3_marker</name><pose>15.0 4.0 2.5 0 0 0</pose></include>
    <include><uri>model://waypoint_marker</uri><name>wp4_marker</name><pose>20.0 0.0 2.5 0 0 0</pose></include>

    <model name="obstacle_cylinder_1">
      <static>true</static><pose>2.5 0.0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>4.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.4</radius><length>4.0</length></cylinder></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_box_1">
      <static>true</static><pose>7.5 2.0 2.0 0 0 -0.5</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 1.0 4.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 1.0 4.0</size></box></geometry>
          <material><ambient>0.2 0.2 0.8 1</ambient><diffuse>0.2 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder_2">
      <static>true</static><pose>12.5 2.5 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>4.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.4</radius><length>4.0</length></cylinder></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.1 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_cylinder_3">
      <static>true</static><pose>12.5 5.5 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>4.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.4</radius><length>4.0</length></cylinder></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.1 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_box_2">
      <static>true</static><pose>17.5 2.0 2.0 0 0 0.5</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 1.0 4.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 1.0 4.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>0.8 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder_4">
      <static>true</static><pose>22.5 0.0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>4.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.4</radius><length>4.0</length></cylinder></geometry>
          <material><ambient>0.8 0.5 0.1 1</ambient><diffuse>0.8 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://landing_pad</uri>
      <name>landing_pad</name>
      <pose>25.0 0.0 0 0 0 0</pose>
    </include>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>12.5 -10.0 15.0 0 0.8 1.57</pose>
      </camera>
    </gui>

  </world>
</sdf>
